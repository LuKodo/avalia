# ---------------------------------------------------------------------------
# LTP - Configuracion de entorno
#
# NUNCA se versiona el archivo .env real. Este ejemplo solo declara los nombres
# de las variables; los valores reales se inyectan en el servidor con permisos
# restringidos (chmod 600) o desde el gestor de secretos.
# ---------------------------------------------------------------------------
APP_NAME=LTP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos -----------------------------------------------------------
#
# ARRANQUE RAPIDO (sin configurar nada): SQLite.
#   DB_CONNECTION=sqlite
#   Cree el archivo vacio:  database/database.sqlite
#   Nota: sobre SQLite no se aplican los disparadores de solo-anexado de la
#   bitacora. Sirve para probar la aplicacion, no para operar.
#
# ESTE EQUIPO: MySQL de XAMPP responde en el puerto 3307, no en el 3306.
#   DB_CONNECTION=mysql / DB_PORT=3307
#
# PRODUCCION: PostgreSQL 16. Requiere habilitar la extension pdo_pgsql en
#   php.ini (en este equipo NO esta activa; ver README).
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ltp
DB_USERNAME=root
DB_PASSWORD=

# Rol de solo anexado para la bitacora inmutable (ver docs/trazabilidad.md)
DB_BITACORA_USERNAME=
DB_BITACORA_PASSWORD=

# --- Cache, colas y sesiones -------------------------------------------------
# Para probar en local, `database` evita tener que montar Redis. En produccion
# se cambia a redis: las colas sobre base de datos no aguantan el volumen de
# notificaciones y webhooks de una operacion real.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Tiempo real (Laravel Reverb) -------------------------------------------
# `log` desactiva el tiempo real sin romper nada: el panel cae a consulta
# periodica. Se cambia a `reverb` cuando el servidor WebSocket este montado.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Servicios externos ------------------------------------------------------
GOOGLE_ROUTES_API_KEY=
MAPTILER_KEY=

# --- Trazabilidad ------------------------------------------------------------
# Clave de sellado diario de la cadena de auditoria. En produccion debe vivir
# fuera del alcance de la aplicacion (HSM o gestor de secretos).
LTP_SELLO_CLAVE=

# --- Parametros de operacion (valores por defecto, ajustables en el panel) ---
LTP_PESO_CERCANIA=35
LTP_PESO_HOLGURA=25
LTP_PESO_CARGA=20
LTP_PESO_RUTA=15
LTP_PESO_DESEMPENO=5
LTP_RADIO_BUSQUEDA_KM=15
